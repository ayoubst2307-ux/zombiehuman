-- ============================================================
--  AIMBOT LOOP
-- ============================================================
local function screen_center() local vp=Camera.ViewportSize; return Vector2.new(vp.X/2,vp.Y/2) end

local function get_target()
    local center=screen_center(); local best_p: Player?=nil; local best_sp: Vector2?=nil; local best_d=CFG.aimbot_fov
    for _,p in ipairs(Players:GetPlayers()) do
        if p==LocalPlayer then continue end
        if CFG.aimbot_enemy_only and not is_enemy(p) then continue end
        local char=p.Character; if not char then continue end
        local part=char:FindFirstChild(CFG.aimbot_part) :: BasePart?
        local hum=char:FindFirstChildOfClass("Humanoid")
        if not part or not hum or hum.Health<=0 then continue end
        if CFG.aimbot_wallcheck and not has_los(part) then continue end
        local sp,vis=Camera:WorldToViewportPoint(part.Position)
        if not vis then continue end
        local sp2=Vector2.new(sp.X,sp.Y); local d=(sp2-center).Magnitude
        if d<best_d then best_d=d; best_p=p; best_sp=sp2 end
    end
    return best_p,best_sp
end

local aim_held=false
UIS.InputBegan:Connect(function(i,gpe) if not gpe and i.KeyCode==CFG.aimbot_key then aim_held=true end end)
UIS.InputEnded:Connect(function(i) if i.KeyCode==CFG.aimbot_key then aim_held=false end end)

RunService.RenderStepped:Connect(function()
    local center=screen_center()
    fov_circle.Visible=CFG.aimbot_enabled; fov_circle.Position=center
    if not CFG.aimbot_enabled then target_dot.Visible=false; return end
    local _,sp=get_target()
    if sp then
        if aim_held then
            local cur=UIS:GetMouseLocation()
            mousemoverel((sp-cur).X*CFG.aimbot_smooth,(sp-cur).Y*CFG.aimbot_smooth)
        end
        target_dot.Position=sp; target_dot.Visible=true
    else target_dot.Visible=false end
end)

