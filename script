-- ============================================================
--  TEAM / ENEMY
-- ============================================================
local function is_enemy(p: Player): boolean
    if not LocalPlayer.Team then return true end
    return p.Team ~= LocalPlayer.Team
end

local function team_color(p: Player): Color3
    if not is_enemy(p) then return Color3.fromRGB(50,200,255) end
    local char = p.Character
    if char and char:FindFirstChild("Zombie") then return Color3.fromRGB(100,255,50) end
    return Color3.fromRGB(255,50,50)
end

-- ============================================================
--  WALL CHECK
-- ============================================================
local function has_los(target: BasePart): boolean
    local char = LocalPlayer.Character
    if not char then return false end
    local root = char:FindFirstChild("HumanoidRootPart") :: BasePart?
    if not root then return false end
    local params = RaycastParams.new()
    params.FilterDescendantsInstances = {char}
    params.FilterType = Enum.RaycastFilterType.Exclude
    local result = workspace:Raycast(root.Position, target.Position - root.Position, params)
    if not result then return true end
    return result.Instance:IsDescendantOf(target.Parent)
end

-- ============================================================
--  TP BYPASS
--  Micro-steps 8 studs + freeze hum pendant le tp
--  Le serveur voit un déplacement physique progressif
-- ============================================================
local tp_busy = false

local function safe_tp(dest: Vector3)
    if tp_busy then return end
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart") :: BasePart?
    local hum  = char:FindFirstChildOfClass("Humanoid")
    if not root or not hum then return end

    tp_busy = true

    -- sauvegarde vitesse
    local prev_ws = hum.WalkSpeed
    local prev_jp = hum.JumpPower
    hum.WalkSpeed = 0
    hum.JumpPower = 0

    -- désactive noclip temporairement pour pas conflicte
    local prev_noclip = CFG.noclip_enabled
    CFG.noclip_enabled = false

    local start  = root.Position
    local dist   = (dest - start).Magnitude
    local steps  = math.max(1, math.ceil(dist / 8))

    for i = 1, steps do
        if not char or not char.Parent then break end
        local t = i / steps
        root.CFrame = CFrame.new(start:Lerp(dest, t))
        -- wait proportionnel = vitesse perçue ≈ walkspeed normale
        task.wait(0.06)
    end

    -- restore
    hum.WalkSpeed      = prev_ws
    hum.JumpPower      = prev_jp
    CFG.noclip_enabled = prev_noclip
    tp_busy = false
end

-- ============================================================
--  ANTI FALL DAMAGE
--  Avant l'impact : state Physics + zero vélocité Y
-- ============================================================
local fall_conn: RBXScriptConnection? = nil

local function start_antifall()
    if fall_conn then return end
    fall_conn = RunService.Heartbeat:Connect(function()
        if not CFG.antifall_enabled then return end
        local char = LocalPlayer.Character
        if not char then return end
        local root = char:FindFirstChild("HumanoidRootPart") :: BasePart?
        local hum  = char:FindFirstChildOfClass("Humanoid")
        if not root or not hum then return end
        -- si on tombe vite → annule la vélocité verticale négative
        if root.AssemblyLinearVelocity.Y < -40 then
            root.AssemblyLinearVelocity = Vector3.new(
                root.AssemblyLinearVelocity.X,
                -10, -- cap la chute à -10 studs/s → no damage
                root.AssemblyLinearVelocity.Z
            )
        end
    end)
end
start_antifall()

