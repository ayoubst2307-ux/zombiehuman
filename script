-- ============================================================
local esp_cache: {[Player]: {box:any,name:any,hp:any,team_lbl:any}} = {}

local function esp_add(p: Player)
    if esp_cache[p] then return end
    local function sq(f,c) local d=Drawing.new("Square"); d.Thickness=1.5; d.Filled=f; d.Color=c; d.Visible=false; return d end
    local function tx(s,c) local d=Drawing.new("Text"); d.Size=s; d.Center=true; d.Outline=true; d.Color=c; d.Visible=false; return d end
    esp_cache[p]={box=sq(false,Color3.fromRGB(255,50,50)),name=tx(12,Color3.fromRGB(255,255,255)),hp=sq(true,Color3.fromRGB(60,255,60)),team_lbl=tx(10,Color3.fromRGB(255,255,255))}
end
local function esp_hide(p: Player)
    if not esp_cache[p] then return end
    for _,d in pairs(esp_cache[p]) do d.Visible=false end
end
local function esp_remove(p: Player)
    if not esp_cache[p] then return end
    for _,d in pairs(esp_cache[p]) do d:Remove() end
    esp_cache[p]=nil
end
Players.PlayerRemoving:Connect(esp_remove)

RunService.RenderStepped:Connect(function()
    for _,p in ipairs(Players:GetPlayers()) do
        if p==LocalPlayer then continue end
        local char=p.Character; if not char then esp_hide(p); continue end
        local root=char:FindFirstChild("HumanoidRootPart") :: BasePart?
        local hum=char:FindFirstChildOfClass("Humanoid")
        if not root or not hum then esp_hide(p); continue end
        if not CFG.esp_enabled then esp_hide(p); continue end
        local dist=(root.Position-Camera.CFrame.Position).Magnitude
        if dist>CFG.esp_max_dist then esp_hide(p); continue end
        esp_add(p)
        local ds=esp_cache[p]; local col=team_color(p)
        local sp,vis=Camera:WorldToViewportPoint(root.Position)
        if not vis then esp_hide(p); continue end
        local scale=1600/dist; local bw,bh=scale*1.0,scale*1.8
        ds.box.Color=col; ds.box.Size=Vector2.new(bw,bh); ds.box.Position=Vector2.new(sp.X-bw/2,sp.Y-bh/2); ds.box.Visible=true
        ds.name.Text=p.DisplayName; ds.name.Position=Vector2.new(sp.X,sp.Y-bh/2-14); ds.name.Visible=true
        ds.team_lbl.Text="[".. (p.Team and p.Team.Name or "?") .."] "..math.floor(dist).."m"; ds.team_lbl.Color=col; ds.team_lbl.Position=Vector2.new(sp.X,sp.Y+bh/2+2); ds.team_lbl.Visible=true
        local ratio=math.clamp(hum.Health/math.max(hum.MaxHealth,1),0,1)
        ds.hp.Color=Color3.fromRGB(math.floor((1-ratio)*255),math.floor(ratio*200),50); ds.hp.Size=Vector2.new(3,bh*ratio); ds.hp.Position=Vector2.new(sp.X-bw/2-7,sp.Y-bh/2+bh*(1-ratio)); ds.hp.Visible=true
